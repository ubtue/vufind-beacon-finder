<?php $heading = $this->translate('beaconfinder_heading'); ?>
<p><b><?=$heading !== 'beaconfinder_heading' ? $this->escapeHtml($heading) : 'BEACONfinder'?></b></p>
<?php $result = $this->BEACONfinder->getByAuthorityId($this->authorityId); ?>
<?php if (!$result || count($result) == 0): ?>
  <p>Not found</p>
<?php else: ?>
  <ul>
    <?php foreach ($result as $item): ?>
      <li>
        <?php if (!empty($item->getTargetUri())): ?>
          <a href="<?=$this->escapeHtmlAttr($item->getTargetUri())?>" target="_blank" rel="noopener noreferrer"><?=$this->escapeHtml($item->getNAME() ?: $item->getTargetUri())?></a>
        <?php else: ?>
          <?=$this->escapeHtml($item->getBeaconUri())?>
        <?php endif; ?>
      </li>
    <?php endforeach; ?>
  </ul>
<?php endif; ?>
